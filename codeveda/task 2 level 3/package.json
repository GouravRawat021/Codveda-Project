{
  "name": "brightpath-ui",
  "version": "1.0.0",
  "description": "Reusable UI components for Django projects, built with Tailwind CSS.",
  
  "main": "dist/components.css",
  
  "files": [
    "dist/",
    "templates/"
  ],
  
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/components.css --minify",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  
  "keywords": [
    "django",
    "ui",
    "components",
    "tailwind"
  ],
  
  "author": "CodeVeda Student",
  "license": "MIT",
  
  "devDependencies": {
    "@storybook/addon-essentials": "^7.0.0",
    "@storybook/addon-interactions": "^7.0.0",
    "@storybook/addon-links": "^7.0.0",
    "@storybook/html": "^7.0.0",
    "storybook": "^7.0.0",
    "storybook-django": "^1.0.0",
    "tailwindcss": "^3.4.0"
  },
  
  "peerDependencies": {
    "django": ">=3.2"
  }
}
